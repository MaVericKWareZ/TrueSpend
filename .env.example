# Backend (apps/api)
MONGODB_URI=mongodb://localhost:27017/expense-tracker
JWT_SECRET=replace-me-with-a-32-plus-character-random-string
PORT=3001
NODE_ENV=development

# Frontend (apps/web) — server-only; do NOT prefix with NEXT_PUBLIC_
API_BASE_URL=http://localhost:3001
DEV_JWT=paste-output-of-pnpm-issue-dev-jwt-here

# Docker Compose
# When running via `docker compose up`, only JWT_SECRET is required.
# MONGODB_URI defaults to mongodb://host.docker.internal:27017/expense-tracker
# (your Mongo running on the host). DEV_JWT is minted automatically by the web
# container's entrypoint using JWT_SECRET — you don't need to set it here.
