# --- NextAuth (Next.js side) ---
# URL the app is reachable at. In production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000
# Encrypts NextAuth's JWE session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Backend access token (HS256 JWS verified by apps/api AuthBridge) ---
# MUST match the JWT_SECRET set in apps/api/.env.local — both sides sign/verify
# with the same secret. At least 16 characters.
JWT_SECRET=replace-with-shared-secret-min-16-chars

# --- Backend URL ---
# Public URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:3001
# (Optional) Server-side override used inside Server Components and the
# NextAuth `authorize()` callback. Defaults to NEXT_PUBLIC_API_URL when unset.
API_BASE_URL=http://localhost:3001

# --- Legacy (issue 01 health-check page) ---
# Long-lived dev JWT for the /health-check page. Issue with:
#   pnpm issue-dev-jwt --secret <JWT_SECRET>
DEV_JWT=
